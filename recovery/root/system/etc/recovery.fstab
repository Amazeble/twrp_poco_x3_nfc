# Android fstab file for Android 14+ (AOSP 14).
# <src>                                               <mnt_point>     <type>  <mnt_flags and options>                      <fs_mgr_flags>
/dev/block/by-name/system                            /system         ext4    ro,barrier=1,discard                                 wait,logical
/dev/block/by-name/system_ext                        /system_ext     ext4    ro,barrier=1,discard                                 wait,logical
/dev/block/by-name/product                           /product        ext4    ro,barrier=1,discard                                 wait,logical
/dev/block/by-name/vendor                            /vendor         ext4    ro,barrier=1,discard                                 wait,logical
/dev/block/bootdevice/by-name/cache                  /cache          ext4    nosuid,noatime,nodev,barrier=1                       wait
/dev/block/bootdevice/by-name/metadata               /metadata       ext4    noatime,nosuid,nodev,discard                         wait,formattable,wrappedkey,display=Metadata
/dev/block/bootdevice/by-name/userdata               /data           f2fs    noatime,nosuid,nodev,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt,checkpoint_merge    latemount,wait,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+wrappedkey_v2:keydirectory=/metadata/vold/metadata_encryption:fileencryption=aes-256-cts:v2+wrappedkey_v2
/dev/block/bootdevice/by-name/misc                   /misc           emmc    defaults                                             defaults
